# ── Google OAuth (디캠프 계정 로그인) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=              # openssl rand -base64 32
AUTH_URL=                 # https://dcamp-mentoring-analyzer.vercel.app

# 비밀번호 로그인이 표시되게 하려면 true로 설정
NEXT_PUBLIC_HAS_SITE_PASSWORD=true

# 사이트 비밀번호 보호 (Google OAuth 폴백)
# 미설정 시 Google OAuth만 사용
SITE_PASSWORD=

# API 인증 (설정 시 /api/* 엔드포인트에 Bearer 토큰 또는 x-api-key 필요)
# 미설정 시 인증 없이 접근 가능 (개발 환경용)
API_SECRET=

# Vercel Cron 인증 (매일 아침/저녁 자동 동기화용)
# Vercel 대시보드 > Settings > Environment Variables에서 설정
CRON_SECRET=

# Anthropic API Key (Claude API 사용에 필요)
ANTHROPIC_API_KEY=your_api_key_here

# Notion API (Internal Integration Token)
NOTION_API_KEY=your_notion_api_key_here

# Notion Database IDs
NOTION_COMPANIES_DB_ID=2e07563d3dc0819ebe94d6327e8ab4eb
NOTION_MENTORS_DB_ID=2e07563d3dc081b7b7d7f017522b88ad
NOTION_MEETINGS_DB_ID=2e07563d3dc0812f8cb4ecd0c09195d0
NOTION_EXPERT_REQUESTS_DB_ID=2e07563d3dc081c68de8f6a9ade86430

# 추가 Notion Database IDs (브리핑 v2)
NOTION_KPT_DB_ID=2e07563d3dc08111ade7d51c41244949
NOTION_OKR_ITEMS_DB_ID=2e07563d3dc081608c5cc00064714929
NOTION_OKR_VALUES_DB_ID=2e07563d3dc081629b88e8d0b69c9eda
